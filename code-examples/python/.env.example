# Local data and vector database
RAG_DATA_DIR=./data
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=rag_documents

# Embedding model (downloaded on first use)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
MAX_UPLOAD_MB=15

# Optional OpenAI-compatible generation endpoint.
# For local Ollama, the server must be reachable from this environment.
# In Codespaces, localhost means the Codespace, not your personal computer.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
